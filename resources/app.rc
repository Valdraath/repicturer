#include <windows.h>

// glfw picks up the icon named GLFW_ICON for its window class
GLFW_ICON ICON "app.ico"
1 ICON "app.ico"

1 RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "RePicturer"
            VALUE "ProductName", "RePicturer"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "OriginalFilename", "RePicturer.exe"
            VALUE "InternalName", "RePicturer"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
